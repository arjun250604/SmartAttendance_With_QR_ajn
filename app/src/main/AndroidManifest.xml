<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartAttendance">

        <!-- Entry point -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartAttendance.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.PendingActivity"
            android:exported="false" />

        <!-- Admin -->
        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.CreateUserActivity"
            android:exported="false" />

        <!-- Teacher -->
        <activity
            android:name=".ui.teacher.TeacherDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.teacher.GenerateQRActivity"
            android:exported="false" />

        <!-- Student -->
        <activity
            android:name=".ui.student.StudentDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.ScanQRActivity"
            android:exported="false" />

        <!-- Shared -->
        <activity
            android:name=".ui.attendance.AttendanceHistoryActivity"
            android:exported="false" />

    </application>

</manifest>