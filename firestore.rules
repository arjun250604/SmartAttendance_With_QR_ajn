rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if caller is admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection
    match /users/{userId} {
      // Admin can read all users; others can only read their own
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());

      // Admin can create any user document (when creating accounts for others)
      // User can only write their own document
      allow create: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());

      // Admin can update any user (role assignment, etc.)
      // User can only update their own
      allow update: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());

      // Only admin can delete user documents
      allow delete: if isAdmin();
    }

    // Sessions (QR codes) - teachers create, all authenticated users can read
    match /sessions/{sessionId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';

      allow update: if request.auth != null &&
        (resource.data.teacherUid == request.auth.uid || isAdmin());

      allow delete: if request.auth != null &&
        (resource.data.teacherUid == request.auth.uid || isAdmin());
    }

    // Attendance Records - students can create their own; teachers and admin can read all
    match /attendance_records/{recordId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null &&
        request.resource.data.studentUid == request.auth.uid &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';

      allow update: if false;  // Records are immutable
      allow delete: if isAdmin();
    }
  }
}
